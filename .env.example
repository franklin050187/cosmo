POSTGRES_HOST=your-host.supabase.com
POSTGRES_USER=your-user
POSTGRES_PORT=6543
POSTGRES_DATABASE=postgres
POSTGRES_PASSWORD=your-password

JWT_SECRET=<generate-with-openssl-rand-hex-32>
UPLOADTHING_TOKEN=your-uploadthing-token

DISCORD_CLIENT_ID=your-discord-app-id
DISCORD_CLIENT_SECRET=your-discord-app-secret
DISCORD_REDIRECT_URI=http://localhost:8000/callback
CLIENT_URL=http://localhost:8000
DISCORD_GUILD_EXCELSIOR_ID=546229904488923141
DISCORD_GUILD_COSMOTEER_ID=314103695568666625

ADMIN_USERNAMES="someuser"

TURNSTILE_SECRET=your-turnstile-secret
NEXT_PUBLIC_TURNSTILE_SITEKEY=your-turnstile-site-key

# ── Optional ─────────────────────────────────────────────────────
POSTGRES_CA=      # Supabase pooler CA cert (PEM). If unset, falls back to the built-in Supabase CA.
ALLOWED_ORIGINS=http://localhost:8000   # Comma-separated allowed CORS origins. If unset, no CORS headers are sent.

# Analytics
# ANALYTICS_ANON_SALT=random-string     # Salt for hashing anonymous visitors (IP + UA). Keeps anon identity stable.
# ANALYTICS_EXCLUDE_USERNAMES=poney5850#0   # Default usernames excluded from the dashboard (toggle in the UI overrides).
# ANALYTICS_EXCLUDE_ANON_IDS=<anon_id>  # Anonymous visitor ids (anon_id) also excluded whenever a username exclusion applies. Set to the pinned QA-run identity (scripts/qa-lib.ts QA_ANON_ID).

# ── QA suite (scripts/qa-suite.ts) ───────────────────────────────
# Exclude poney's (the real user's) personal data from no-trace assertions.
# Without this, P4-N1 snapshots poney's favorites at suite start and asserts
# the suite didn't change them; set to "true" to skip that check entirely.
# QA_EXCLUDE_PONEY_DATA=false
