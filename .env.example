POSTGRES_HOST=your-host.supabase.com
POSTGRES_USER=your-user
POSTGRES_PORT=6543
POSTGRES_DATABASE=postgres
POSTGRES_PASSWORD=your-password

JWT_SECRET=<generate-with-openssl-rand-hex-32>
UPLOADTHING_TOKEN=your-uploadthing-token

DISCORD_CLIENT_ID=your-discord-app-id
DISCORD_CLIENT_SECRET=your-discord-app-secret
DISCORD_REDIRECT_URI=http://localhost:8000/callback
CLIENT_URL=http://localhost:8000
DISCORD_GUILD_EXCELSIOR_ID=546229904488923141
DISCORD_GUILD_COSMOTEER_ID=314103695568666625

ADMIN_USERNAMES="someuser"

TURNSTILE_SECRET=your-turnstile-secret
NEXT_PUBLIC_TURNSTILE_SITEKEY=your-turnstile-site-key

# ── Optional ─────────────────────────────────────────────────────
POSTGRES_CA=      # Supabase pooler CA cert (PEM). If unset, falls back to the built-in Supabase CA.
ALLOWED_ORIGINS=http://localhost:8000   # Comma-separated allowed CORS origins. If unset, no CORS headers are sent.
